# # =============================================================================
# # Cocopeat - Environment Variables Contract
# # =============================================================================
# # Copy this file to `.env` and fill in real values.
# # DO NOT commit `.env` (only `.env.example` is tracked, see .gitignore).
# #
# # Convention:
# #   - Server-only vars: plain names (DATABASE_URL, PORT, ...)
# #   - Client-exposed vars: MUST be prefixed with NEXT_PUBLIC_
# #     (inlined into the browser bundle at build time — never put secrets here)
# # =============================================================================


# # -----------------------------------------------------------------------------
# # Database (Prisma + pg)
# # -----------------------------------------------------------------------------
# # PostgreSQL connection string consumed by `src/lib/prisma.ts` via the
# # @prisma/adapter-pg Pool. Format:
# #   postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# DATABASE_URL="postgresql://postgres.rogrznluzdbakcyxnczx:[PASSWORD DB]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
//Salin DATABASE_URL ini ke env. di project local klen

# # -----------------------------------------------------------------------------
# # Backend (Express server — src/index.ts)
# # -----------------------------------------------------------------------------
# # Port the Express API listens on. Defaults to 4000 if unset.
# PORT=4000

# # Allowed CORS origin for the Express API. Point this at your Next.js app.
# # Defaults to http://localhost:3000 if unset.
# FRONTEND_URL="http://localhost:3000"


# # -----------------------------------------------------------------------------
# # Runtime
# # -----------------------------------------------------------------------------
# # Usually set automatically by Next.js / Node tooling.
# # Valid values: development | production | test
# # NODE_ENV=development


# # -----------------------------------------------------------------------------
# # Client-exposed (NEXT_PUBLIC_*) — inlined into browser bundle
# # -----------------------------------------------------------------------------
# # Add NEXT_PUBLIC_* vars here when needed by client components.
# # WARNING: Values are PUBLIC. Never put secrets, API keys, or tokens here.
# #
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# Supabase Client configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
