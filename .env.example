# Cocopeat — environment variable contract.
# Copy this file to .env and fill in real values. .env is gitignored.

# Supabase (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key from Supabase Studio → Project Settings → API.
# SERVER-ONLY. Never expose. Used to seed/maintain the default admin user.
SUPABASE_SERVICE_ROLE_KEY=

# Default admin credentials. The app auto-creates / promotes this user
# to role=admin on first /api/auth/login or /api/admin/seed call.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Prisma (Supabase Postgres). Both come from Supabase Studio → Project
# Settings → Database → Connection string.
#
# Pooled connection (transaction pooler, port 6543) used by the app at runtime.
# Keep pgbouncer=true and connection_limit=1 — serverless functions otherwise
# exhaust pooler slots.
DATABASE_URL=

# Direct connection (port 5432) used by the Prisma CLI only. Introspection and
# advisory locks cannot run through the transaction pooler, so `db pull` and
# `studio` need this. Same credentials, different port, no query params.
DIRECT_URL=

# Optional: official Shopee shop link shown in navbar + CTA section.
# When unset, those buttons are hidden.
NEXT_PUBLIC_SHOPEE_SHOP_URL=
