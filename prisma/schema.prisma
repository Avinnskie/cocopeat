generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"

}

model Product {
  id                String                 @id
  slug              String                 @unique
  name              String
  price             Decimal                @db.Decimal
  originalPrice     Decimal?               @db.Decimal
  description       String                 @db.Text
  longDescription   String?                @db.Text
  image             String
  gallery           String[]               @default([])
  badge             String?
  badgeColor        String?
  stock             Int?                   @default(0)
  rating            Float?                 @default(0.0)
  reviewCount       Int?                   @default(0)
  highlights        String[]               @default([])
  specs             ProductSpec[]
  technicalSpecs    TechnicalSpec[]
  batchInfo         BatchInfo?
  sustainability    SustainabilityMetric[]
  applications      UsageApplication[]
  comparison        ComparisonItem[]
  storage           StorageInfo?
  farmerPartnership FarmerPartnership?
  orders            OrderItem[]
}

model ProductSpec {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String

  @@index([productId])
}

model TechnicalSpec {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String

  @@index([productId])
}

model BatchInfo {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String   @unique
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber    String
  processingDate String
  sourceLocation String
  certifications String[] @default([])
}

model SustainabilityMetric {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  icon      String

  @@index([productId])
}

model UsageApplication {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  icon        String
  description String?  @db.Text

  @@index([productId])
}

model ComparisonItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  metric           String
  cocopeatPlus     String
  regularSoil      String
  peatMoss         String
  importedCocopeat String

  @@index([productId])
}

model StorageInfo {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String   @unique
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  instructions    String[] @default([])
  shelfLife       String
  rehydrationTime String
  waterRatio      String
}

model FarmerPartnership {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String  @unique
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  farmerCount Int
  region      String
  description String  @db.Text
}

model Order {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerName  String?
  customerPhone String?
  platform      String
  totalAmount   Decimal?    @db.Decimal
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  items         OrderItem[]

  @@index([createdAt, status])
}

model OrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal

  @@unique([orderId, productId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}